{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/run-inbox.schema.json",
  "title": "SpruceAgent Run Inbox",
  "type": "object",
  "required": ["version", "createdAt", "status", "summary", "pendingApprovals", "resumableRuns", "recentRuns", "limits"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["clear", "action_required", "ready_to_resume"]
    },
    "summary": {
      "type": "object",
      "required": ["pendingApprovalCount", "resumableRunCount", "recentRunCount"],
      "additionalProperties": false,
      "properties": {
        "pendingApprovalCount": { "type": "integer", "minimum": 0 },
        "resumableRunCount": { "type": "integer", "minimum": 0 },
        "recentRunCount": { "type": "integer", "minimum": 0 }
      }
    },
    "pendingApprovals": {
      "type": "array",
      "items": { "type": "object" }
    },
    "resumableRuns": {
      "type": "array",
      "items": { "type": "object" }
    },
    "recentRuns": {
      "type": "array",
      "items": { "type": "object" }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
