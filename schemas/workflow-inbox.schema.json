{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/workflow-inbox.schema.json",
  "title": "SpruceAgent Workflow Inbox",
  "type": "object",
  "required": ["version", "createdAt", "status", "summary", "workflowRuns", "limits"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["clear", "action_required"]
    },
    "summary": {
      "type": "object",
      "required": ["workflowRunCount", "pendingApprovalCount"],
      "additionalProperties": false,
      "properties": {
        "workflowRunCount": { "type": "integer", "minimum": 0 },
        "pendingApprovalCount": { "type": "integer", "minimum": 0 }
      }
    },
    "workflowRuns": {
      "type": "array",
      "items": { "type": "object" }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
