{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/workflow-detail.schema.json",
  "title": "SpruceAgent Workflow Detail",
  "type": "object",
  "required": [
    "version",
    "traceId",
    "status",
    "summary",
    "workflow",
    "results",
    "steps",
    "approvals",
    "toolResults",
    "resumeEvents",
    "evaluations",
    "timeline",
    "events",
    "limits"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "traceId": { "type": "string", "pattern": "^trace_[a-z0-9_]+$" },
    "status": {
      "type": "string",
      "enum": ["completed", "dry_run", "requires_approval", "completed_with_blockers"]
    },
    "summary": {
      "type": "object",
      "required": [
        "goal",
        "workflowId",
        "workflowName",
        "eventCount",
        "stepCount",
        "resultCount",
        "pendingApprovalCount",
        "resumableStepCount",
        "toolResultCount",
        "evaluationCount"
      ],
      "additionalProperties": false,
      "properties": {
        "goal": { "type": ["string", "null"] },
        "workflowId": { "type": ["string", "null"] },
        "workflowName": { "type": ["string", "null"] },
        "eventCount": { "type": "integer", "minimum": 0 },
        "stepCount": { "type": "integer", "minimum": 0 },
        "resultCount": { "type": "integer", "minimum": 0 },
        "pendingApprovalCount": { "type": "integer", "minimum": 0 },
        "resumableStepCount": { "type": "integer", "minimum": 0 },
        "toolResultCount": { "type": "integer", "minimum": 0 },
        "evaluationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "items": { "type": "object" }
    },
    "steps": {
      "type": "array",
      "items": { "type": "object" }
    },
    "approvals": {
      "type": "array",
      "items": { "type": "object" }
    },
    "toolResults": {
      "type": "array",
      "items": { "type": "object" }
    },
    "resumeEvents": {
      "type": "array",
      "items": { "type": "object" }
    },
    "evaluations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "createdAt", "label", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "label": { "type": "string" },
          "status": { "type": ["string", "null"] }
        }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "trace-event.schema.json" }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
