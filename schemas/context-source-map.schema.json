{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/context-source-map.schema.json",
  "title": "SpruceAgent ContextOS Source Map",
  "type": "object",
  "required": ["version", "createdAt", "query", "index", "summary", "sources", "limits"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "query": { "type": ["string", "null"] },
    "index": { "type": ["object", "null"] },
    "summary": {
      "type": "object",
      "required": ["sourceCount", "byType", "topWorkspacePath"],
      "additionalProperties": false,
      "properties": {
        "sourceCount": { "type": "integer", "minimum": 0 },
        "byType": { "type": "object" },
        "topWorkspacePath": { "type": ["string", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "path",
          "title",
          "score",
          "snippet",
          "hash",
          "bytes",
          "lineCount",
          "indexedAt",
          "freshness",
          "confidence",
          "metadata"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["workspace", "memory", "skill", "llm"] },
          "path": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "score": { "type": ["number", "null"] },
          "snippet": { "type": "string" },
          "hash": { "type": ["string", "null"] },
          "bytes": { "type": ["integer", "null"] },
          "lineCount": { "type": ["integer", "null"] },
          "indexedAt": { "type": ["string", "null"] },
          "freshness": { "type": "string" },
          "confidence": { "type": "string" },
          "metadata": { "type": "object" }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
