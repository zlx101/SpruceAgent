{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/workflow-continuation.schema.json",
  "title": "SpruceAgent Workflow Continuation",
  "type": "object",
  "required": ["version", "status", "traceId", "sourceWorkflow", "resultCount", "summary", "results", "limits"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["completed", "requires_approval", "completed_with_blockers"]
    },
    "traceId": { "type": "string", "pattern": "^trace_[a-z0-9_]+$" },
    "sourceWorkflow": {
      "type": "object",
      "required": ["id", "name", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] }
      }
    },
    "resultCount": { "type": "integer", "minimum": 0 },
    "summary": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "results": {
      "type": "array",
      "items": { "type": "object" }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
