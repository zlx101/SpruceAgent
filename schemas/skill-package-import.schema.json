{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/skill-package-import.schema.json",
  "title": "SpruceAgent Skill Package Import",
  "type": "object",
  "required": ["id", "packageId", "candidateSkillId", "originalSkillId", "importedAt", "integrityHash", "package"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^skill_import_[a-z0-9_]+$" },
    "packageId": { "type": "string", "pattern": "^skill_pkg_[a-z0-9_]+$" },
    "candidateSkillId": { "type": "string", "pattern": "^skill_[a-z0-9_]+$" },
    "originalSkillId": {
      "anyOf": [
        { "type": "string", "pattern": "^skill_[a-z0-9_]+$" },
        { "type": "null" }
      ]
    },
    "importedAt": { "type": "string", "format": "date-time" },
    "integrityHash": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "package": { "type": "object" }
  }
}
