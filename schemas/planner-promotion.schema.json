{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/planner-promotion.schema.json",
  "title": "SpruceAgent Planner Promotion",
  "type": "object",
  "required": ["version", "source", "status", "summary", "allowedTools", "stepCount", "promotedSteps", "limits"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "source": {
      "anyOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "status": { "type": "string", "enum": ["ready", "requires_approval", "blocked"] },
    "summary": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "allowedTools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stepCount": { "type": "integer", "minimum": 0 },
    "promotedSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "promotionStatus", "executable", "reason"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "promotionStatus": {
            "type": "string",
            "enum": ["ready", "requires_approval", "blocked", "not_promotable"]
          },
          "executable": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
