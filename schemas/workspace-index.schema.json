{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/workspace-index.schema.json",
  "title": "SpruceAgent Workspace Index",
  "type": "object",
  "required": ["version", "indexedAt", "root", "documentCount", "skippedCount", "maxBytes", "documents", "skipped"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer" },
    "indexedAt": { "type": "string", "format": "date-time" },
    "root": { "type": "string" },
    "documentCount": { "type": "integer", "minimum": 0 },
    "skippedCount": { "type": "integer", "minimum": 0 },
    "redactedDocumentCount": { "type": "integer", "minimum": 0 },
    "maxBytes": { "type": "integer", "minimum": 1 },
    "incremental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "previousIndexedAt": { "type": ["string", "null"], "format": "date-time" },
        "reusedDocumentCount": { "type": "integer", "minimum": 0 },
        "addedCount": { "type": "integer", "minimum": 0 },
        "changedCount": { "type": "integer", "minimum": 0 },
        "unchangedCount": { "type": "integer", "minimum": 0 },
        "deletedCount": { "type": "integer", "minimum": 0 },
        "skippedCount": { "type": "integer", "minimum": 0 },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "added": {
              "type": "array",
              "items": { "type": "string" }
            },
            "changed": {
              "type": "array",
              "items": { "type": "string" }
            },
            "unchanged": {
              "type": "array",
              "items": { "type": "string" }
            },
            "deleted": {
              "type": "array",
              "items": { "type": "string" }
            },
            "skipped": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "reason"],
                "additionalProperties": true,
                "properties": {
                  "path": { "type": "string" },
                  "reason": { "type": "string" }
                }
              }
            }
          }
        },
        "limits": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "extension", "bytes", "mtimeMs", "hash", "lineCount", "content"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "extension": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "mtimeMs": { "type": "number" },
          "hash": { "type": "string" },
          "lineCount": { "type": "integer", "minimum": 0 },
          "content": { "type": "string" },
          "redacted": { "type": "boolean" },
          "redactionCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": true,
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignoredRuleCount": { "type": "integer", "minimum": 0 },
        "sensitiveSkipCount": { "type": "integer", "minimum": 0 },
        "redactedDocumentCount": { "type": "integer", "minimum": 0 },
        "redactionPatterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
