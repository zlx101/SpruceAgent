{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/run-preflight.schema.json",
  "title": "SpruceAgent Run Preflight Report",
  "type": "object",
  "required": ["version", "kind", "startedAt", "completedAt", "status", "canProceed", "policy", "context", "actions", "blockers", "warnings", "limits"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "kind": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["passed", "warning", "blocked"]
    },
    "canProceed": { "type": "boolean" },
    "policy": {
      "type": "object",
      "required": ["requireFreshContext", "refreshContext"],
      "additionalProperties": false,
      "properties": {
        "requireFreshContext": { "type": "boolean" },
        "refreshContext": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object",
      "required": ["initial", "final", "refreshed", "index"],
      "additionalProperties": false,
      "properties": {
        "initial": { "type": "object" },
        "final": { "type": "object" },
        "refreshed": { "type": "boolean" },
        "index": {
          "type": ["object", "null"]
        }
      }
    },
    "actions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "object" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "object" }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
