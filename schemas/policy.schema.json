{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/policy.schema.json",
  "title": "SpruceAgent Policy Decision",
  "type": "object",
  "required": ["decision", "riskLevel", "reasons", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["allow", "requires_approval", "deny"]
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  }
}
