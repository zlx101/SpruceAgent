{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/approval-queue.schema.json",
  "title": "SpruceAgent Approval Queue",
  "type": "object",
  "required": ["version", "createdAt", "status", "summary", "items", "limits"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["clear", "action_required", "ready_to_resume"]
    },
    "summary": {
      "type": "object",
      "required": ["total", "pendingDecisionCount", "readyToResumeCount", "approvedUnresumableCount", "completedCount"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pendingDecisionCount": { "type": "integer", "minimum": 0 },
        "readyToResumeCount": { "type": "integer", "minimum": 0 },
        "approvedUnresumableCount": { "type": "integer", "minimum": 0 },
        "completedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": { "type": "object" }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
