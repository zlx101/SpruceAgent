{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceagent.dev/schemas/run-risk-preflight.schema.json",
  "title": "SpruceAgent Run Risk Preflight Report",
  "type": "object",
  "required": ["version", "kind", "startedAt", "completedAt", "status", "canProceed", "trustMode", "summary", "decisions", "blockers", "warnings", "limits"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "kind": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["passed", "warning", "blocked"]
    },
    "canProceed": { "type": "boolean" },
    "trustMode": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["total", "allow", "requires_approval", "deny", "blocked", "not_executable", "unknownTool", "byRiskLevel"],
      "additionalProperties": true,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "allow": { "type": "integer", "minimum": 0 },
        "requires_approval": { "type": "integer", "minimum": 0 },
        "deny": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "not_executable": { "type": "integer", "minimum": 0 },
        "unknownTool": { "type": "integer", "minimum": 0 },
        "byRiskLevel": { "type": "object" }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "object" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "object" }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
