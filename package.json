{
  "name": "spruceagent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The open-source SuperAgent OS for future super individuals and super teams.",
  "bin": {
    "spruce": "apps/cli/bin/spruce.js"
  },
  "scripts": {
